<Project Sdk="Microsoft.NET.Sdk">
  <!-- Exercises the Unity-independent online versus core over real loopback UDP.
       Run from the repository root: dotnet run, project Tools/NetplayTests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Unity compiles this source as C# 9. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>../../Temp/NetplayTests/bin/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Eclipse/Multiplayer/Online/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
