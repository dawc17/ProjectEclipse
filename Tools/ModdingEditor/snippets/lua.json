{
  "Eclipse weapon and shop listing": {
    "prefix": "eclipse-weapon",
    "description": "Register a weapon and a level-1 coin listing. Requires content.register, core dependency, localization and sprite files.",
    "body": [
      "local sf2 = require(\"sf2\")",
      "",
      "local weapon = sf2.items.register_weapon {",
      "    id = \"${1:training_blade}\",",
      "    display_name = sf2.localization.key(\"${2:weapon.training_blade}\"),",
      "    icon = sf2.assets.sprite(\"${3:sprites/weapon}\"),",
      "    model = sf2.assets.model(\"core:gamedata/models/mdl_weapon_katana_ritual\"),",
      "    subtype = \"Katana\",",
      "}",
      "",
      "sf2.shop.addItem {",
      "    section = sf2.shop.WEAPONS,",
      "    item = weapon,",
      "    level = 1,",
      "    price = sf2.price.coins(${4:1}),",
      "}",
      "$0"
    ]
  },
  "Import Eclipse API": {
    "prefix": "eclipse-api",
    "description": "Load the Eclipse API in this Lua file.",
    "body": [
      "local sf2 = require(\"sf2\")",
      "$0"
    ]
  },
  "Combat behavior": {
    "prefix": "eclipse-behavior",
    "description": "Register a behavior; attach the returned handle to a perk or enchantment. Requires content.register.",
    "body": [
      "local ${1:behavior} = sf2.behaviors.register {",
      "    id = \"${2:my_behavior}\",",
      "    parameters = { amount = { type = \"number\", default = 5 } },",
      "    on_damage_received = function(params, fighter, event)",
      "        -- Requires combat.change_life in mod.toml.",
      "        fighter:change_health(params.amount)",
      "        $0",
      "    end,",
      "}"
    ]
  },
  "Stateful behavior": {
    "prefix": "eclipse-stateful",
    "description": "Track state separately for each fighter using this behavior.",
    "body": [
      "local ${1:behavior} = sf2.behaviors.register {",
      "    id = \"${2:hit_counter}\",",
      "    state = {",
      "        lifetime = \"fight\",",
      "        fields = { hits = { type = \"integer\", default = 0 } },",
      "    },",
      "    on_damage_dealt = function(self, fighter, event)",
      "        self.state.hits = self.state.hits + 1",
      "        $0",
      "    end,",
      "}"
    ]
  },
  "Incoming damage modifier": {
    "prefix": "eclipse-damage",
    "description": "Scale incoming damage in the supported callback. Requires combat.modify_hit.",
    "body": [
      "local ${1:behavior} = sf2.behaviors.register {",
      "    id = \"${2:damage_reduction}\",",
      "    on_damage_resolving = function(params, fighter, event)",
      "        fighter:scale_incoming_damage(${3:0.8})",
      "    end,",
      "}",
      "$0"
    ]
  },
  "Persistent mod state": {
    "prefix": "eclipse-state",
    "description": "Declare saved fields before reading or writing them. Requires state.write and state.read.",
    "body": [
      "sf2.state.register {",
      "    version = 1,",
      "    fields = {",
      "        ${1:visits} = { type = \"integer\", default = 0 },",
      "    },",
      "}",
      "local ${2:visits} = sf2.state.get(\"${1:visits}\") or 0",
      "sf2.state.set { ${1:visits} = ${2:visits} + 1 }",
      "$0"
    ]
  },
  "Mod sprite": {
    "prefix": "eclipse-sprite",
    "description": "Load a sprite; select a real indexed sprite inside the quotes.",
    "body": [
      "local ${1:icon} = sf2.assets.sprite(\"${2:sprites/weapon}\")",
      "$0"
    ]
  },
  "Localization handle": {
    "prefix": "eclipse-localization",
    "description": "Resolve a localization key declared in localizations/*.toml.",
    "body": [
      "local ${1:name} = sf2.localization.key(\"${2:weapon.training_blade}\")",
      "$0"
    ]
  },
  "Perk registration": {
    "prefix": "eclipse-perk",
    "description": "Attach a previously registered behavior to a perk.",
    "body": [
      "local ${1:perk} = sf2.perks.register {",
      "    id = \"${2:my_perk}\",",
      "    display_name = sf2.localization.key(\"${3:perk.name}\"),",
      "    description = sf2.localization.key(\"${4:perk.description}\"),",
      "    kind = sf2.perks.SINGLE,",
      "    behavior = ${5:behavior},",
      "}",
      "$0"
    ]
  },
  "Eclipse guarded native move patch": {
    "prefix": "eclipse-move-patch",
    "description": "Patch a named native interval with an expected-value guard. Requires content.patch.",
    "body": [
      "-- Requires content.patch in mod.toml.",
      "sf2.moves.patch {",
      "    move = \"${1:RangedHeavyPlayer}\",",
      "    interval_end = { name = \"${2:Uninterrupt}\", expected = ${3:42}, value = ${4:40} },",
      "}",
      "$0"
    ]
  },
  "Eclipse native move input and priority": {
    "prefix": "eclipse-move-input",
    "description": "Retarget one native Tap input and selection priority with expected-value guards. Requires content.patch.",
    "body": [
      "-- Requires content.patch in mod.toml.",
      "sf2.moves.patch {",
      "    move = \"${1:SaturnBlasterAbilityPlayer}\",",
      "    input = { expected = \"${2:Super}\", value = \"${3:RaidCharge}\" },",
      "    priority = { expected = ${4:1000}, value = ${5:200} },",
      "}",
      "$0"
    ]
  },
  "Eclipse native interval start": {
    "prefix": "eclipse-move-interval-start",
    "description": "Patch one native interval start with an expected-value guard. Requires content.patch.",
    "body": [
      "-- Requires content.patch in mod.toml.",
      "sf2.moves.patch {",
      "    move = \"${1:LightingChainPlayer}\",",
      "    interval_start = { name = \"${2:Uninterrupt}\", expected = ${3:9}, value = ${4:0} },",
      "}",
      "$0"
    ]
  },
  "Eclipse scheduled native effect": {
    "prefix": "eclipse-move-effect",
    "body": [
      "[${1:2}] = { effect = {",
      "    name = \"${2:SmallSphereStart}\", core_sequence = \"${3:mgc_magic_small_sphere_start}\",",
      "    scale = 0.75, time_scale = 1.45,",
      "    position = { node = \"${4:Magic-Node2_1}\", player = \"Me\", y = 80 },",
      "    follow = true,",
      "} },"
    ],
    "description": "Inside a move timeline; requires content.register and a compatible core effect/rig."
  },
  "Eclipse attached native effect": {
    "prefix": "eclipse-move-effect-attach",
    "body": [
      "[${1:13}] = { effect = {",
      "    name = \"${2:ElectroEffect}\", core_sequence = \"${3:mgc_effect_shocker}\",",
      "    attach = { player = \"Me\", root_point = \"${4:NStomach}\",",
      "        attach_point = \"${5:NChest}\", offset_x = 0, offset_y = 0 },",
      "} },"
    ],
    "description": "Inside a move timeline; follows a pair of live model nodes."
  },
  "Eclipse stop native sound": {
    "prefix": "eclipse-move-stop-sound",
    "body": [
      "${1:animation_end} = { stop_sound = \"${2:snd_blade_fury}\" },"
    ],
    "description": "Stop an exact native sound when a move ends or is interrupted."
  },
  "Eclipse play child animation": {
    "prefix": "eclipse-move-play-child",
    "body": [
      "[${1:17}] = { play_animation = ${3:child_move}, player = \"Child\",",
      "    child_name = \"${2:BlackHand}\" },"
    ],
    "description": "Start a registered move on a named child actor; define child_move first."
  },
  "Eclipse scheduled projectile": {
    "prefix": "eclipse-move-projectile",
    "body": [
      "[${1:2}] = { projectile = {",
      "    name = \"${2:Sphere1}\", core_skeleton = \"${3:SkeletonMagic}\", copy_parent_type = \"Magic\",",
      "} },",
      "[${4:7}] = { add_bullets = \"MagicBullet\", amount = -1 },"
    ],
    "description": "Inside a caster move timeline; requires a complete compatible projectile graph."
  },
  "Eclipse named-item projectile": {
    "prefix": "eclipse-move-projectile-item",
    "body": [
      "[${1:22}] = { projectile = {",
      "    name = \"${2:Earthquake}\", core_skeleton = \"${3:SkeletonMagic}\",",
      "    item = sf2.items.get(\"core:items/magic/${4:MAGIC_BUTCHER_EARTHQUAKE}\"), start_move = ${5:child_move},",
      "} },"
    ],
    "description": "Equip a resolved hidden item on a child actor; define child_move first."
  },
  "Eclipse projectile flight fields": {
    "prefix": "eclipse-projectile-flight",
    "body": [
      "conditions = { { actor = \"${1:Sphere1}\" } },",
      "velocity = { x = ${2:30} },",
      "no_magic_recharge = true,"
    ],
    "description": "Fields inside a projectile move definition; requires its remaining graph and compatible animation."
  },
  "Eclipse sphere attack options": {
    "prefix": "eclipse-spell-attack-options",
    "body": [
      "options = {",
      "    no_effect = true, no_critical = true, ignores_block = true,",
      "    body_part = \"Body\", defense_types = { \"BodyDefense\" },",
      "    ignores_invulnerable = { \"Evade\", \"Recovery\", \"Dash\", \"ShroudInterval\" },",
      "},"
    ],
    "description": "Native spell options inside a move attack table; requires compatible edges and complete graph."
  },
  "Eclipse saved dialogue sequence": {
    "prefix": "eclipse-story-sequence",
    "description": "Play typed dialogue steps with a declared integer cursor (default 1). Requires story.events, ui.create, state.read and state.write.",
    "body": [
      "sf2.story.play_sequence {",
      "    position = \"${1:dialogue_next}\",",
      "    steps = {",
      "        { dialog = {",
      "            lines = { { text = ${2:body_text} } },",
      "            button = ${3:button_text},",
      "        } },",
      "    },",
      "    on_complete = function()",
      "        ${0:-- Mark the pending story complete.}",
      "    end,",
      "}"
    ]
  }
}
