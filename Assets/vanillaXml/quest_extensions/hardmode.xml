<?xml version="1.0" encoding="utf-8"?>
<Quests>
  <Quest Name="UnlockHardmode" Priority="-9999">
    <Events>
      <FightEnd/>
    </Events>
    <Conditions>
      <Equal Value1="?Fight[_$Fight].Fight" Value2="6"/>
      <Equal Value1="?Fight[_$Fight].Type" Value2="BOSSES"/>
      <Less Not="1" Value1="?Fight[_$Fight].WinCount" Value2="1"/>
    </Conditions>
    <Actions Place="Map">
      <ShowBattle Name="?Concat[?Fight[_$Fight].Zone,|,BOSS_HARDMODE]"/>
      <HideBattle Name="?Concat[?Fight[_$Fight].Zone,|,?Fight[_$Fight].Battle]"/>
    </Actions>
  </Quest>
  <Quest Name="HardmodeReminder" Priority="-9999">
    <Events>
      <FightEnd/>
    </Events>
    <Conditions>
      <Equal Not="1" Value1="?Fight[_$Fight].Zone" Value2="ZONE_1"/>
      <Equal Value1="?Fight[_$Fight].Fight" Value2="1"/>
      <Equal Value1="?Fight[_$Fight].Type" Value2="TOURNAMENT"/>
      <Less Not="1" Value1="?Fight[_$Fight].WinCount" Value2="1"/>
      <GreaterEqual Not="1" Value1="?Fight[?Concat[ZONE_,(?Slice[?Fight[_$Fight].Zone,5,5] - 1),|BOSS_HARDMODE|1]].WinCount" Value2="1"/>
    </Conditions>
    <Actions Place="Map">
      <Dialog Type="Multiline" Title="_Title_Assistant" Image="_Avatar_Assistant_1">
        <Line Text="dlgHardmodeReminder" ButtonText="dlgStoryBtnMore"/>
        <Button Type="Left" Text="dlgLaterBtn" Color="Red"/>
        <Button Type="Right" Color="Green" Text="dlgStoryBtnShowme">
          <SetMapFocus Battle="?Concat[ZONE_,(?Slice[?Fight[_$Fight].Zone,5,5] - 1),|BOSS_HARDMODE|]" Frames="100"/>
          <Wait Frames="100" Lock="Silent"/>
        </Button>
      </Dialog>
    </Actions>
  </Quest>
  <Quest Name="HardmodeReminder_GatesOfShadows" Group="FightEnter" Priority="9999" Unresumable="1">
    <Events>
      <FightEnter/>
    </Events>
    <Conditions>
      <Equal Value1="?Fight[_$Fight].Zone" Value2="ZONE_6"/>
      <Equal Value1="?Fight[_$Fight].Battle" Value2="FINAL_BATTLE"/>
      <Operator Type="Or">
        <Less Value1="?Fight[?Concat[ZONE_1|BOSS_HARDMODE|1]].WinCount" Value2="1"/>
        <Less Value1="?Fight[?Concat[ZONE_2|BOSS_HARDMODE|1]].WinCount" Value2="1"/>
        <Less Value1="?Fight[?Concat[ZONE_3|BOSS_HARDMODE|1]].WinCount" Value2="1"/>
        <Less Value1="?Fight[?Concat[ZONE_4|BOSS_HARDMODE|1]].WinCount" Value2="1"/>
        <Less Value1="?Fight[?Concat[ZONE_5|BOSS_HARDMODE|1]].WinCount" Value2="1"/>
        <Less Value1="?Fight[?Concat[ZONE_6|BOSS_HARDMODE|1]].WinCount" Value2="1"/>
      </Operator>
      <Equal Not="1" Value1="_HardmodeReminder_GatesOfShadowsCheckBox" Value2="1"/>
    </Conditions>
    <Actions Place="Map">
      <Dialog Type="Regular" Title="_Title_Assistant" Image="_Avatar_Assistant_1">
        <Line Text="dlgHardmodeReminder_GatesOfShadows" ButtonText="dlgStoryBtnMore"/>
        <Button Type="Right" Color="Beige" Text="OK">
          <SetVariable Scope="Users" Name="HardmodeReminder_GatesOfShadowsCheckBox" Value="1"/>
          <ClearQuestQueue Name="FightEnter"/>
        </Button>
      </Dialog>
    </Actions>
  </Quest>
</Quests>
