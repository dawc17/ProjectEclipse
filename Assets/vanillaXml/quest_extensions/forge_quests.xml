  <Quest Name="SuperEnchantmentActivation" Unresumable="1" Priority="99998">
    <Events>
      <ActivatePerk/>
    </Events>
    <Conditions>
      <Equal Value1="_SuperEnchantmentActive" Value2="1" Not="1"/>
    </Conditions>
    <Actions>
      <SetVariable Scope="Local" Name="PerkImage" Value="?Concat[img::,?PerkInfo[_$PerkName].Icon]"/>
      <SetVariable Scope="Users" Name="SuperEnchantmentActive" Value="1"/>
      <Dialog Type="Notification" Image="character_puppeteer">
        <Line Text="super_enchantment_activate{_PerkImage}"/>
        <Button Type="Left" Color="Green"/>
        <Button Type="Right" Color="Green" Text="OK"/>
      </Dialog>
    </Actions>
  </Quest>
  <Quest Name="SuperEnchantmentDeactivation" Unresumable="1" Priority="99999">
    <Events>
      <DeactivatePerk/>
    </Events>
    <Conditions>
      <Equal Value1="_SuperEnchantmentActive" Value2="1"/>
    </Conditions>
    <Actions>
      <SetVariable Scope="Local" Name="PerkImage" Value="?Concat[img::,?PerkInfo[_$PerkName].Icon]"/>
      <SetVariable Scope="Users" Name="SuperEnchantmentActive" Value="0"/>
      <Dialog Type="Notification" Image="character_puppeteer">
        <Line Text="super_enchantment_deactive{_PerkImage}"/>
        <Button Type="Left" Color="Green"/>
        <Button Type="Right" Color="Green" Text="OK"/>
      </Dialog>
    </Actions>
  </Quest>
