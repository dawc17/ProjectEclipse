        <Line Text="zone6_shogun_defeated_1" ButtonText="dlgStoryBtnMore"/>
        <Button Type="Right" Color="Beige" Text="dlgStoryBtnMore"/>
      </Dialog>
      <Dialog Type="Regular" Title="NAME_SHOGUN" Image="boss_shogun">
        <Line Text="zone6_shogun_defeated_2" ButtonText="dlgStoryBtnMore"/>
        <Button Type="Right" Color="Beige" Text="dlgStoryBtnMore"/>
      </Dialog>
      <Dialog Type="Regular" Title="drop_name_jadeseal" Image="img_drop_jade_seal">
        <Line Text="zone6_seal_drop" ButtonText="dlgStoryBtnMore"/>
        <Button Type="Right" Color="Beige" Text="dlgStorySeal">
          <GiveItem Name="drop_name_jadeseal" PutOn="0" Quantity="1"/>
        </Button>
      </Dialog>
      <Dialog Type="Regular" Title="characterSensei" Image="character_sensei">
        <Line Text="zone6_shogun_defeated_3"/>
        <Button Type="Right" Color="Beige" Text="OK"/>
      </Dialog>
      <If>
        <Conditions>
          <Equal Value1="?UnlockedCharacters[].NAME_SHOGUN" Value2="0"/>
          <Operator Type="Or">
            <Equal Value1="?SysInfo[].Switch" Value2="1"/>
            <Equal Value1="?SysInfo[].Steam" Value2="1"/>
          </Operator>
        </Conditions>
        <Then>
          <Dialog Type="Regular" Title="NAME_SHOGUN" Image="boss_shogun" IgnoreBack="1">
            <Line Text="PvP_char_unlocked"/>
            <Button Type="Right" Color="Beige" Text="OK"/>
          </Dialog>
          <UnlockCharacter Name="NAME_SHOGUN"/>
        </Then>
      </If>
    </Actions>
  </Quest>
