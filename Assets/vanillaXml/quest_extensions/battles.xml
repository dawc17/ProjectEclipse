  <Quest Name="ChallengeEnter" Priority="-9" Group="ChallengeService|FightEnter" Unresumable="1">
    <Events>
      <Activate/>
    </Events>
    <Conditions>
      <Equal Value1="_$ActionID" Value2="ChallengeDialog"/>
      <Operator Type="Or">
        <Greater Value1="?Item[?Fight[_CurrentChallenge].Helm].Quantity" Value2="0"/>
        <Equal Value1="?Fight[_CurrentChallenge].Helm" Value2=""/>
      </Operator>
      <Operator Type="Or">
        <Greater Value1="?Item[?Fight[_CurrentChallenge].Armor].Quantity" Value2="0"/>
        <Equal Value1="?Fight[_CurrentChallenge].Armor" Value2=""/>
      </Operator>
      <Operator Type="Or">
        <Greater Value1="?Item[?Fight[_CurrentChallenge].Weapon].Quantity" Value2="0"/>
        <Equal Value1="?Fight[_CurrentChallenge].Weapon" Value2=""/>
      </Operator>
      <Operator Type="Or">
        <Greater Value1="?Item[?Fight[_CurrentChallenge].Ranged].Quantity" Value2="0"/>
        <Equal Value1="?Fight[_CurrentChallenge].Ranged" Value2=""/>
      </Operator>
      <Operator Type="Or">
        <Greater Value1="?Item[?Fight[_CurrentChallenge].Magic].Quantity" Value2="0"/>
        <Equal Value1="?Fight[_CurrentChallenge].Magic" Value2=""/>
      </Operator>
      <Less Value1="?Purchase[?Player[].Helm].UpgradeLevel" Value2="100 * ?Fight[_CurrentChallenge].HelmLevel" Not="1"/>
      <Less Value1="?Purchase[?Player[].Armor].UpgradeLevel" Value2="100 * ?Fight[_CurrentChallenge].ArmorLevel" Not="1"/>
      <Less Value1="?Purchase[?Player[].Weapon].UpgradeLevel" Value2="100 * ?Fight[_CurrentChallenge].WeaponLevel" Not="1"/>
      <Less Value1="?Purchase[?Player[].Ranged].UpgradeLevel" Value2="100 * ?Fight[_CurrentChallenge].RangedLevel" Not="1"/>
      <Less Value1="?Purchase[?Player[].Magic].UpgradeLevel" Value2="100 * ?Fight[_CurrentChallenge].MagicLevel" Not="1"/>
    </Conditions>
    <Actions>
      <Dialog Type="Multiline" Title="_Title_Announcer" Image="_Avatar_Announcer">
        <Line Text="?Concat[_AnnouncerPrefix,?Fight[_CurrentChallenge].Description]" ButtonText="dlgStoryBtnMore"/>
        <Button Type="Right" Text="dlgStoryBtnFight" Color="Beige">
          <SetVariable Scope="Users" Name="ChallengeRunning" Value="1"/>
          <Fight Name="_CurrentChallenge"/>
          <ClearQuestQueue Name="DiscountService"/>
        </Button>
        <Button Type="Left" Text="dlgStoryBtnLeave" Color="Red"/>
      </Dialog>
    </Actions>
  </Quest>
