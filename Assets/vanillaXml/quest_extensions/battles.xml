<Quests>
  <Quest Name="FindTopItems" Priority="-9" Group="ChallengeService|FightEnter" Unresumable="1">
    <Events>
      <FightEnter/>
    </Events>
    <Conditions>
      <Equal Value1="_ChallengeRunning" Value2="1" Not="1"/>
      <Operator Type="Or">
        <Equal Value1="?Fight[_$Fight].Battle" Value2="Challenge"/>
        <Equal Value1="?Fight[_$Fight].Battle" Value2="Challenge1_1"/>
        <Equal Value1="?Fight[_$Fight].Battle" Value2="Challenge_INTERMISSION"/>
        <Equal Value1="?Fight[_$Fight].Battle" Value2="Challenge_ECLIPSEMODE"/>
        <Equal Value1="?Fight[_$Fight].Battle" Value2="C3_Challenge"/>
      </Operator>
    </Conditions>
    <Actions Place="Map">
      <SetVariable Scope="Users" Name="CurrentChallenge" Value="_$Fight"/>
      <SetVariable Scope="Users" Name="ChallengeDenied" Value="0"/>
      <Activate ActionID="ChallengeDialog"/>
    </Actions>
  </Quest>
  <Quest Name="ChallengeRun" Priority="-9" Group="ChallengeService|FightEnter" Unresumable="1">
