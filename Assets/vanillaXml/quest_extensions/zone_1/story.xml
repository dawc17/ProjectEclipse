  <Quest Name="SurvivalUnlock" Priority="30">
    <Events>
      <FightEnd/>
    </Events>
    <Conditions>
      <Equal Value1="?Fight[_$Fight].Zone" Value2="ZONE_1"/>
      <Equal Value1="?Battle[ZONE_1|Survival|].Available" Value2="0"/>
      <Equal Value1="_SurvivalUnlock" Value2="1" Not="1"/>
      <Equal Value1="?Fight[_$Fight].Battle" Value2="Tournament"/>
      <Operator Type="Or">
        <Operator Type="And">
          <Equal Value1="_$FightResult" Value2="Loss"/>
          <Greater Value1="?Fight[_$Fight].LossCount" Value2="1"/>
          <Operator Type="Or">
            <Greater Value1="_$BestAcquiredArmorLevel" Value2="0"/>
            <Less Value1="?Player[].Money" Value2="?Item[ARMOR_ROBE].Price"/>
          </Operator>
        </Operator>
        <Operator Type="And">
          <Equal Value1="_$FightResult" Value2="Loss"/>
          <Greater Value1="_$BestAcquiredHelmLevel" Value2="0"/>
          <Greater Value1="_$BestAcquiredArmorLevel" Value2="0"/>
        </Operator>
        <Operator Type="And">
          <Equal Value1="_$FightResult" Value2="Win"/>
          <Equal Value1="?Fight[ZONE_1|Tournament|6].WinCount" Value2="0" Not="1"/>
        </Operator>
      </Operator>
    </Conditions>
    <Actions Place="Map">
      <Dialog Type="Regular" Title="characterMay" Image="character_may_1">
        <Line Text="tutorial_tournament_fail_1" ButtonText="dlgStoryBtnMore"/>
        <Line Text="tutorial_tournament_fail_2" ButtonText="dlgStoryBtnMore"/>
        <Line Text="tutorial_tournament_fail_3" ButtonText="dlgStoryBtnMore"/>
        <Button Type="Right" Color="Beige" Text="OK"/>
      </Dialog>
      <ShowBattle Name="ZONE_1|Survival" Locked="0"/>
      <SetMapFocus Battle="ZONE_1|Survival|"/>
      <SetVariable Scope="Users" Name="SurvivalUnlock" Value="1"/>
    </Actions>
  </Quest>
