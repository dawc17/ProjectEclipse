  <Quest Name="Zone5Stranger1DifficultyAlert">
    <Events>
      <Activate/>
    </Events>
    <Conditions>
      <Equal Value1="_$ActionID" Value2="Zone5Stranger1Alert"/>
      <Greater Value1="?Fight[?Concat[ZONE_5|Stranger|lvl,_StrangerTriggerLevel]].Difficulty" Value2="2"/>
      <Equal Value1="_Zone5Stranger1DifficultyAlert" Value2="1" Not="1"/>
