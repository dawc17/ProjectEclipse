      <ShowBattle Name="ZONE_6|Duel|" Locked="1"/>
      <ShowBattle Name="ZONE_6|Survival|"/>
      <ShowBattle Name="ZONE_6|Challenge|" Locked="1"/>
      <SetMapFocus Battle="ZONE_6|BOSS_SAMURAI|"/>
      <Checkpoint/>
      <Wait Frames="60" Lock="Silent" ControlsLock="1"/>
      <ActScreen Text="Act_6" Lock="Silent"/>
      <If>
        <Conditions>
          <Equal Value1="?UnlockedCharacters[].BOSS_HUNTRESS" Value2="0"/>
          <Operator Type="Or">
            <Equal Value1="?SysInfo[].Switch" Value2="1"/>
            <Equal Value1="?SysInfo[].Steam" Value2="1"/>
          </Operator>
        </Conditions>
        <Then>
          <Dialog Type="Regular" Title="BOSS_HUNTRESS" Image="boss_huntress" IgnoreBack="1">
            <Line Text="PvP_char_unlocked"/>
            <Button Type="Right" Color="Beige" Text="OK"/>
          </Dialog>
          <UnlockCharacter Name="BOSS_HUNTRESS"/>
        </Then>
      </If>
      <Activate ActionID="Zone6StartDialog"/>
      <Activate ActionID="FightsLeftReminder"/>
    </Actions>
